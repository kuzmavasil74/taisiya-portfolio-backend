# MongoDB connection string (a replica set is required for transactions; Atlas works)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/taisiya

JWT_SECRET=change-me
JWT_EXPIRES=1d

# Telegram bot (create one with @BotFather); chat id of the chat/group that gets booking notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true on exactly one running instance, otherwise Telegram answers 409 Conflict
ENABLE_BOT_POLLING=false

# optional: extra allowed CORS origins, comma-separated
CORS_ORIGINS=

PORT=4000
